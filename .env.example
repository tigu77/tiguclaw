# LLM 런타임 (Claude)

# 데이터 홈 — 세션·메모리·DB·agents·skills 가 전부 여기 아래에 저장됩니다.
# 비우면 기본 ~/.tiguclaw. 원하는 경로로 바꿔도 됩니다 (절대경로 권장, 상대경로도 허용).
#   예) TIGUCLAW_HOME=/data/tiguclaw   또는   TIGUCLAW_HOME=~/my-assistant
# ★ 이 값은 daemon:install 시 서비스(launchd)에도 그대로 구워집니다 — 설치 전에 정하세요.
#   (개발은 npm run dev 가 ./tiguclaw-dev 를 자동 사용.)
TIGUCLAW_HOME=
ANTHROPIC_API_KEY=
# Claude 구독 OAuth — `claude setup-token` 으로 발급. ANTHROPIC_API_KEY 대신 사용 가능(claude 어댑터가 둘 중 하나 인식).
CLAUDE_CODE_OAUTH_TOKEN=

# LLM 어댑터 선택은 아래 REGION_A_MODELS(provider:model 콤마 풀)로 통일됨.
# 구 REGION_A_ADAPTER 는 폐기 — src 어디서도 참조되지 않음. REGION_A_MODELS 를 쓰세요.

# OpenAI Platform API (V3 어댑터, OPENAI_API_KEY 와 같이 사용)
OPENAI_MODEL=

# ChatGPT OAuth 우회 (V3.1 어댑터, `npm run codex-auth` 로 자동 발급)
OPENAI_CODEX_OAUTH_TOKEN=
OPENAI_CODEX_OAUTH_REFRESH=
OPENAI_CODEX_OAUTH_EXPIRES=
OPENAI_CODEX_MODEL=

# 멀티 LLM 프로바이더 키 - 사용할 프로바이더만 채우면 됨
OPENAI_API_KEY=
# Google Gemini — OpenAI-compat 엔드포인트(generativelanguage.../v1beta/openai/)로 라우팅됨.
GOOGLE_GENERATIVE_AI_API_KEY=
# Ollama(로컬) — 어댑터가 자동으로 끝에 "/v1" 을 붙인다(OpenAI-compat 규약).
# 즉 여기엔 "/v1" 없이 호스트만 넣으면 됨. 미설정 시 http://localhost:11434 사용.
# 로컬이라 API 키 불필요(어댑터가 더미 "ollama" 자동 사용). OLLAMA_API_KEY 는 보통 빈 채로 둠.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# LLM 모델 풀 — provider:model, 콤마 순서 = 폴백 우선순위. 단일 파이프라인이 이 풀을 탄다.
# provider: anthropic→claude(에이전틱 SDK) / codex→codex-oauth / openai→@openai/agents
#           ollama→@openai/agents(로컬 baseURL) / google→@openai/agents(gemini compat)
# 예) 로컬 메인:  REGION_A_MODELS=ollama:gemma3,anthropic:claude-opus-4-7
# 예) gemini 메인: REGION_A_MODELS=google:gemini-2.5-pro,anthropic:claude-opus-4-7
REGION_A_MODELS=codex:gpt-5.5,anthropic:claude-opus-4-7

# sub-agent 등급(티어) → 모델 폴백 풀. agent.md 의 model: high/mid/low 가 매핑됨.
# 콤마 = 폴백. 모델 세대 바뀌면 여기만 수정 (agent.md 는 등급만 가리킴).
MODEL_TIER_HIGH=anthropic:claude-opus-4-7
MODEL_TIER_MID=anthropic:claude-sonnet-4-6
MODEL_TIER_LOW=anthropic:claude-haiku-4-5
# nano = 로컬 경량 풀. agent.md 의 model: nano + tools: none 조합으로 분류·추출·요약
# 같은 단순 텍스트 작업을 로컬 모델에 위임 (도구 0·메모리 생략 = lean).
# 라이브 검증(2026-06-15): 7b(qwen2.5:7b)는 단순작업 정확, 3b(llama3.2:3b)는 lean
# 에서도 풀 하네스 무게에 작업을 못 따라옴(에이전트 정의를 읊음). → 7b 권장.
# 미설정 시 spawn 이 어댑터 디폴트로 graceful 폴백 (회귀 0).
MODEL_TIER_NANO=ollama:qwen2.5:7b

# Telegram 채널
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# HTTP 채널 (http-bridge 플러그인)
# 포트 미설정 시 기본 3001. 여러 데몬(설치본 + dev) 동시 구동 시 충돌 회피로 분리 지정.
HTTP_BRIDGE_PORT=3001  # ← 분리가 필요 없으면 이 줄을 지워도 된다(코드 기본값과 동일).
# 바인딩 호스트 — 기본 127.0.0.1 (로컬 전용, LAN 비노출 = 안전 기본). 다른 기기·LAN 에서
# 호출해야 할 때만 HTTP_BRIDGE_HOST=0.0.0.0 (토큰 인증은 항상 적용되나 노출면이 늘어남).
HTTP_BRIDGE_HOST=127.0.0.1
# 인증 토큰 (Authorization: Bearer). 미설정 시 부팅마다 임시 토큰 생성(로그 출력).
HTTP_BRIDGE_TOKEN=

# Dashboard (packages/dashboard) UI 서빙 포트 — 브라우저로 http://127.0.0.1:3101 을 연다.
# dashboard 는 위 HTTP_BRIDGE_PORT 로 bridge 에 *연결*하고 DASHBOARD_PORT 로 UI 를 *서빙*한다.
# 기본값은 적어두지 않는 편이 안전하다(코드 기본값과 갈라진다) — 바꿀 때만 주석을 푼다.
# 127.0.0.1 에만 바인딩되며, 원격은 DASHBOARD_HOST 를 여는 대신 사설 네트워크로
# 터널링한다(예: tailscale serve 3101).
# DASHBOARD_PORT=3101

# 데몬
# launchd 서비스 라벨. 기본 com.tiguclaw.daemon. 한 머신에서 2개 이상 인스턴스를
# 상시 가동하려면(예: 일상용 + 검증용) 인스턴스마다 고유 라벨을 지정 — 홈(TIGUCLAW_HOME)·
# 봇(TELEGRAM_BOT_TOKEN)·포트(HTTP_BRIDGE_PORT/DASHBOARD_PORT)도 함께 분리해야 충돌 0.
#   예) TIGUCLAW_SERVICE_LABEL=com.tiguclaw.install
# daemon:install/restart/status/uninstall 이 이 라벨을 따른다(미설정 시 기본 라벨).
# TIGUCLAW_SERVICE_LABEL=com.tiguclaw.daemon
# 선택(레거시 호환): 명시하면 TIGUCLAW_HOME 을 무시하고 이 경로를 data 디렉터리로 우선 사용.
# 미설정 권장 — 미설정 시 TIGUCLAW_HOME/data (정식 경로, line 4 참고)를 사용한다.
# DATA_DIR=./data
LOG_LEVEL=info
NODE_ENV=production
