{
  "name": "tiguclaw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "tiguclaw": "bin/tiguclaw.mjs"
  },
  "description": "Always-on multi-channel AI assistant. Superset of Claude Code capabilities with multi-LLM routing.",
  "keywords": [
    "ai-assistant",
    "claude-code",
    "llm",
    "multi-llm",
    "telegram",
    "daemon",
    "ollama",
    "codex"
  ],
  "author": "tigu77",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tigu77/tiguclaw.git"
  },
  "bugs": {
    "url": "https://github.com/tigu77/tiguclaw/issues"
  },
  "homepage": "https://github.com/tigu77/tiguclaw#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "TIGUCLAW_HOME=./tiguclaw-dev tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "init": "tsx src/scripts/init.ts",
    "onboard": "tsx src/cli.ts onboard",
    "doctor": "tsx --env-file=.env src/scripts/doctor.ts",
    "dashboard": "tsx --env-file=.env packages/dashboard/index.ts",
    "bridge:grant": "tsx --env-file=.env src/scripts/bridge-grant.ts",
    "bridge:tokens": "tsx --env-file=.env src/scripts/bridge-tokens.ts",
    "codex-auth": "tsx --env-file=.env src/scripts/codex-auth.ts",
    "daemon:install": "tsx src/scripts/install-service.ts",
    "daemon:uninstall": "L=${TIGUCLAW_SERVICE_LABEL:-com.tiguclaw.daemon}; launchctl bootout gui/$(id -u)/$L 2>/dev/null; rm -f \"$HOME/Library/LaunchAgents/$L.plist\"; echo \"launchd unloaded ($L)\"",
    "daemon:restart": "launchctl kickstart -k gui/$(id -u)/${TIGUCLAW_SERVICE_LABEL:-com.tiguclaw.daemon} && echo restarted",
    "daemon:status": "launchctl print gui/$(id -u)/${TIGUCLAW_SERVICE_LABEL:-com.tiguclaw.daemon} 2>/dev/null | grep -E 'state =|pid =' || echo 'not loaded'",
    "daemon:logs": "tail -n 40 -f \"${TIGUCLAW_HOME:-$HOME/.tiguclaw}/logs/daemon-$(date +%Y-%m-%d).log\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@openai/agents": "^0.11.4",
    "@openauthjs/openauth": "^0.4.3",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "croner": "^10.0.1",
    "grammy": "^1.30.0",
    "telegram-markdown-formatter": "^0.1.2",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
