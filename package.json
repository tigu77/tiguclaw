{
  "name": "tiguclaw",
  "version": "0.47.0",
  "private": true,
  "type": "module",
  "bin": {
    "tiguclaw": "bin/tiguclaw.mjs"
  },
  "description": "Always-on multi-channel AI assistant. Superset of Claude Code capabilities with multi-LLM routing.",
  "keywords": [
    "ai-assistant",
    "claude-code",
    "llm",
    "multi-llm",
    "telegram",
    "daemon",
    "ollama",
    "codex"
  ],
  "author": "tigu77",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tigu77/tiguclaw.git"
  },
  "bugs": {
    "url": "https://github.com/tigu77/tiguclaw/issues"
  },
  "homepage": "https://github.com/tigu77/tiguclaw#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "build:prod": "tsc -p tsconfig.build.json && node bin/copy-dist-assets.mjs",
    "dev": "node bin/dev.mjs",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "typecheck:bin": "tsc -p tsconfig.bin.json",
    "init": "tsx src/scripts/init.ts",
    "onboard": "node bin/tiguclaw.mjs onboard",
    "doctor": "tsx src/scripts/doctor.ts",
    "dashboard": "tsx --env-file=.env packages/dashboard/index.ts",
    "bridge:grant": "tsx src/scripts/bridge-grant.ts",
    "bridge:tokens": "tsx src/scripts/bridge-tokens.ts",
    "codex-auth": "tsx src/scripts/codex-auth.ts",
    "claude-auth": "tsx src/scripts/claude-auth.ts",
    "daemon:install": "node bin/daemon.mjs install",
    "daemon:install:dev": "TIGUCLAW_HOME=./tiguclaw-dev TIGUCLAW_RUNTIME=source node bin/daemon.mjs install",
    "daemon:uninstall": "node bin/daemon.mjs uninstall",
    "daemon:restart": "node bin/daemon.mjs restart",
    "daemon:update": "node bin/daemon.mjs update",
    "daemon:stop": "node bin/daemon.mjs stop",
    "daemon:start": "node bin/daemon.mjs start",
    "daemon:status": "node bin/daemon.mjs status",
    "daemon:logs": "node bin/daemon.mjs logs",
    "test:regression": "tsx src/scripts/regression/run.ts",
    "diagnose:codex": "tsx src/scripts/diagnose-codex.ts",
    "deploy": "npm run build:prod && node bin/deploy-guard.mjs && npm run daemon:restart",
    "deploy:dev": "sh bin/deploy-dev.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.222",
    "@openai/agents": "^0.17.0",
    "@openauthjs/openauth": "^0.4.3",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "croner": "^10.0.1",
    "diff": "^7.0.0",
    "grammy": "^1.30.0",
    "telegram-markdown-formatter": "^0.1.2",
    "tsx": "^4.0.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
